# Server Configuration
PORT=5000

# MongoDB Database URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# AI Provider API Keys (Dual-Provider System: Groq primary + OpenRouter fallback)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# Speech-to-Text Providers (Deepgram primary + Whisper fallback)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-2

# Firebase Admin SDK Credentials (Base64-encoded Service Account JSON)
FIREBASE_ADMIN_CREDENTIALS_BASE64=your_base64_encoded_firebase_credentials_here

# Optional Fallbacks & Debug Settings
HF_OCR_URL=
WHISPER_SPACE_URL=Ranbirz1/Ranbirz1-mock-interview-whisper
KEEP_TEMP=false
